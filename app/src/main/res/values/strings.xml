private val KULOB_CENTER = LatLng(38.535, 70.82)

class MainActivity : ComponentActivity() {
    private var textToSpeech: TextToSpeech? = null

    private val permissionLauncher = registerForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) { permissions ->
        val granted = permissions[Manifest.permission.ACCESS_FINE_LOCATION] == true ||
            permissions[Manifest.permission.ACCESS_COARSE_LOCATION] == true
        if (granted) {
            fetchCurrentLocation()
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        textToSpeech = TextToSpeech(this) { status ->
            if (status == TextToSpeech.SUCCESS) {
                val locale = Locale("tg", "TJ")
                val result = textToSpeech?.setLanguage(locale)
                if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {
                    textToSpeech?.language = Locale("ru", "RU")
                }
            }
        }

        setContent {
            KulobTaxiMeterTheme {
                TaxiMeterScreen(textToSpeech = textToSpeech, onRequestLocation = { fetchCurrentLocation() })
            }
        }
    }

    override fun onDestroy() {
        textToSpeech?.shutdown()
        super.onDestroy()
    }

    @SuppressLint("MissingPermission")
    private fun fetchCurrentLocation() {
        val context = this
        val fineGranted = ContextCompat.checkSelfPermission(
            context,
            Manifest.permission.ACCESS_FINE_LOCATION
        ) == PackageManager.PERMISSION_GRANTED

        val coarseGranted = ContextCompat.checkSelfPermission(
            context,
            Manifest.permission.ACCESS_COARSE_LOCATION
        ) == PackageManager.PERMISSION_GRANTED

        if (!fineGranted && !coarseGranted) {
            permissionLauncher.launch(
                arrayOf(
                    Manifest.permission.ACCESS_FINE_LOCATION,
                    Manifest.permission.ACCESS_COARSE_LOCATION
                )
            )
            return
        }

        val fusedLocationClient = LocationServices.getFusedLocationProviderClient(context)
        fusedLocationClient.lastLocation.addOnSuccessListener { location ->
            if (location != null) {
                val current = LatLng(location.latitude, location.longitude)
                val activity = this
                activity.runOnUiThread {
                    // State is updated inside Compose and is not accessible here, so this is handled by the UI logic.
                }
            }
        }
    }
}

@Composable
fun TaxiMeterScreen(textToSpeech: TextToSpeech?, onRequestLocation: () -> Unit) {
    val context = LocalContext.current
    val cameraPositionState = rememberCameraPositionState {
        position = CameraPosition.fromLatLngZoom(KULOB_CENTER, 12f)
    }

    var searchQuery by remember { mutableStateOf("") }
    var currentMapLocation by remember { mutableStateOf(KULOB_CENTER) }
    var routeDistanceKm by remember { mutableStateOf(4.5) }
    var isRunning by remember { mutableStateOf(false) }
    var isInsideKulob by remember { mutableStateOf(true) }
    var fareSomoni by remember { mutableStateOf(calculateFare(routeDistanceKm, true)) }

    fun speak(text: String) {
        textToSpeech?.speak(text, TextToSpeech.QUEUE_FLUSH, null, "kulob_taxi")
    }

    fun applySearch() {
        if (searchQuery.isBlank()) return
        val geocoder = Geocoder(context, Locale("tg", "TJ"))
        val result = geocoder.getFromLocationName(searchQuery, 1)?.firstOrNull()
        if (result != null) {
            val latLng = LatLng(result.latitude, result.longitude)
            currentMapLocation = latLng
            routeDistanceKm = distanceKm(KULOB_CENTER, latLng)
            isInsideKulob = isInsideKulob(latLng)
            fareSomoni = calculateFare(routeDistanceKm, isInsideKulob)
            cameraPositionState.position = CameraPosition.fromLatLngZoom(latLng, 13f)
            speak("Ҷойдошти интихобшуда. Масофа ${String.format(Locale("tg", "TJ"), "%.1f", routeDistanceKm)} километр.")
        }
    }

    fun handleStart() {
        isRunning = true
        if (routeDistanceKm <= 0.0) {
            routeDistanceKm = 2.0
        }
        fareSomoni = calculateFare(routeDistanceKm, isInsideKulob)
        speak("Сар шуд. Хизмат оғоз ёфт.")
    }

    fun handleFinish() {
        isRunning = false
        fareSomoni = calculateFare(routeDistanceKm, isInsideKulob)
        speak("Хизмат ба охир расид. Сарфи ниҳоӣ ${String.format(Locale("tg", "TJ"), "%.2f", fareSomoni)} сомонӣ.")
    }

    Scaffold { paddingValues ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(Color(0xFFF4F9FF))
                .padding(paddingValues)
        ) {
            Card(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(16.dp),
                shape = RoundedCornerShape(22.dp),
                colors = CardDefaults.cardColors(containerColor = Color.White),
                elevation = CardDefaults.cardElevation(defaultElevation = 8.dp)
            ) {
                Column(modifier = Modifier.padding(16.dp)) {
                    Image(
                        painter = painterResource(id = R.drawable.kulob_fortress),
                        contentDescription = "Kulob Fortress",
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(140.dp),
                        contentScale = ContentScale.Crop
                    )

                    Text(
                        text = "Kulob Taxi Meter",
                        style = MaterialTheme.typography.headlineSmall,
                        fontWeight = FontWeight.Bold,
                        color = Color(0xFF0D3B66),
                        modifier = Modifier.padding(top = 12.dp)
                    )

                    Text(
                        text = "Кӯлоб – 10 с. барои аввал 2 км, пас аз он 3 с./км дар дохили Кӯлоб ва 4 с./км берун аз Кӯлоб",
                        style = MaterialTheme.typography.bodyMedium,
                        color = Color(0xFF213A4C),
                        modifier = Modifier.padding(top = 4.dp)
                    )

                    OutlinedTextField(
                        value = searchQuery,
                        onValueChange = { searchQuery = it },
                        singleLine = true,
                        keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
                        keyboardActions = KeyboardActions(onSearch = { applySearch() }),
                        leadingIcon = {
                            Icon(Icons.Default.Search, contentDescription = null)
                        },
                        trailingIcon = {
                            Icon(Icons.Default.LocationOn, contentDescription = null)
                        },
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(top = 12.dp),
                        label = { Text("Ҷустуҷӯи ҷой") }
                    )

                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(top = 12.dp),
                        horizontalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        Button(
                            onClick = { handleStart() },
                            modifier = Modifier.weight(1f),
                            colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF1D9BF0))
                        ) {
                            Text("START", fontSize = 18.sp, fontWeight = FontWeight.Bold)
                        }
                        Button(
                            onClick = { handleFinish() },
                            modifier = Modifier.weight(1f),
                            colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF0F766E))
                        ) {
                            Text("FINISH", fontSize = 18.sp, fontWeight = FontWeight.Bold)
                        }
                    }
                }
            }

            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .weight(1f)
                    .padding(horizontal = 16.dp, vertical = 8.dp),
                contentAlignment = Alignment.Center
            ) {
                Card(
                    modifier = Modifier.fillMaxSize(),
                    shape = RoundedCornerShape(22.dp),
                    colors = CardDefaults.cardColors(containerColor = Color.White),
                    elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)
                ) {
                    GoogleMap(
                        modifier = Modifier.fillMaxSize(),
                        cameraPositionState = cameraPositionState,
                        uiSettings = MapUiSettings(
                            compassEnabled = true,
                            zoomControlsEnabled = true,
                            myLocationButtonEnabled = true
                        ),
                        properties = MapProperties(
                            isMyLocationEnabled = false,
                            isTrafficEnabled = false
                        )
                    ) {
                        Marker(
                            state = MarkerState(position = currentMapLocation),
                            title = "Kulob",
                            snippet = "Taxi route"
                        )
                    }
                }
            }

            Card(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(start = 16.dp, end = 16.dp, bottom = 16.dp),
                shape = RoundedCornerShape(18.dp),
                colors = CardDefaults.cardColors(containerColor = Color(0xFF0D3B66))
            ) {
                Column(
                    modifier = Modifier.padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text(
                        text = "Натиҷа: ${String.format(Locale("tg", "TJ"), "%.1f", routeDistanceKm)} км",
                        color = Color.White,
                        fontWeight = FontWeight.Bold,
                        fontSize = 18.sp
                    )
                    Text(
                        text = "Ҳисоб: ${String.format(Locale("tg", "TJ"), "%.2f", fareSomoni)} сомонӣ",
                        color = Color.White,
                        fontSize = 18.sp
                    )
                    Text(
                        text = if (isInsideKulob) "Дар дохили Кӯлоб" else "Берун аз Кӯлоб",
                        color = Color(0xFFB7E4FF),
                        fontSize = 16.sp
                    )
                    if (isRunning) {
                        Text(
                            text = "Хизмат идома дорад",
                            color = Color(0xFFB7E4FF),
                            fontSize = 14.sp
                        )
                    }
                }
            }
        }
    }
}

private fun calculateFare(distanceKm: Double, insideKulob: Boolean): Double {
    val baseCost = 10.0
    val pricePerKm = if (insideKulob) 3.0 else 4.0
    return if (distanceKm <= 2.0) {
        baseCost
    } else {
        baseCost + ((distanceKm - 2.0) * pricePerKm)
    }
}

private fun distanceKm(from: LatLng, to: LatLng): Double {
    val earthRadius = 6371.0
    val dLat = Math.toRadians(to.latitude - from.latitude)
    val dLon = Math.toRadians(to.longitude - from.longitude)
    val lat1 = Math.toRadians(from.latitude)
    val lat2 = Math.toRadians(to.latitude)

    val a = sin(dLat / 2) * sin(dLat / 2) +
        sin(dLon / 2) * sin(dLon / 2) * cos(lat1) * cos(lat2)
    val c = 2 * atan2(sqrt(a), sqrt(1 - a))
    return earthRadius * c
}

private fun isInsideKulob(point: LatLng): Boolean {
    val minLat = 38.47
    val maxLat = 38.62
    val minLon = 70.70
    val maxLon = 70.92
    return point.latitude in minLat..maxLat && point.longitude in minLon..maxLon
}

